/// Uzun kissalar havuzu + eski havuz (yedek)
List<Kissa> tumKissalarUzun() {
  return uzunKissalar;
}

/// Bugunun kissasi - uzun havuzdan
Kissa bugununKissasiUzun() {
  final now = DateTime.now();
  final dayOfYear = now.difference(DateTime(now.year, 1, 1)).inDays;
  return uzunKissalar[dayOfYear % uzunKissalar.length];
}